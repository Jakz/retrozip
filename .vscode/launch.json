{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Catch2 Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/out/tests",  // path to your test binary
      "args": [],                                       // can add Catch2 filters here
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "miDebuggerPath": "/usr/bin/lldb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}